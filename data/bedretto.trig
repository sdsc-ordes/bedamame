        bed:surveyType       bedv:location-type-planned ;
        bed:surveyDate       "2024-01-05"^^xsd:date ;
        bed:surveyedBy       bdr:dv3mpsfsfnftll6asnosnrwjam ;
        bed:coordinateSystem bedv:crs-bedretto-local-v1 ;
        bed:easting          -410.2 ;
        bed:northing         439.1 ;
        bed:elevation        1490.133 ;
        bed:azimuth          [ a qudt:QuantityValue ; qudt:numericValue 30 ; qudt:hasUnit unit:DEG ] ;
        bed:dip              [ a qudt:QuantityValue ; qudt:numericValue -10 ; qudt:hasUnit unit:DEG ] ;
        bed:dipConvention    "negative downward; positive upward" ;
        geo:hasGeometry      [ a geo:Geometry ;
                               geo:asWKT "<https://example.org/bedretto/vocab/crs-bedretto-local-v1> POINT Z (-410.2 439.1 1490.133)"^^geo:wktLiteral ] .
}

